<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" prefWidth="500.0" prefHeight="650.0"
      styleClass="main-background" stylesheets="@ChangePasswordCSS.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.security.ChangePasswordController">

    <padding>
        <Insets top="20" right="50" bottom="20" left="50"/>
    </padding>

    <VBox alignment="CENTER" spacing="10">
        <ImageView fitWidth="280.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="/view/imge/logo_login.png" />
            </image>
        </ImageView>
        <Label text="Thay đổi mật khẩu" styleClass="title-text" />
    </VBox>

    <VBox alignment="CENTER" spacing="15" maxWidth="400" styleClass="password-card">
        <Label text="Vui lòng nhập thông tin bên dưới" style="-fx-text-fill: #757575;" />

        <PasswordField fx:id="oldPasswordField" promptText="Nhập mật khẩu hiện tại" styleClass="input-field" prefHeight="45"/>
        <PasswordField fx:id="newPasswordField" promptText="Nhập mật khẩu mới" styleClass="input-field" prefHeight="45"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu mới" styleClass="input-field" prefHeight="45"/>

        <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" textAlignment="CENTER" minHeight="20" />

        <Button text="THAY ĐỔI" onAction="#handleChangePassword" maxWidth="Infinity" styleClass="action-button" prefHeight="50"/>
    </VBox>

    <Hyperlink text="Quay lại trang chủ" styleClass="link-text" />
</VBox>