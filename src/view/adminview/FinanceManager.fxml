<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.adminc.FinanceManagerController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label text="QUẢN LÝ TÀI CHÍNH &amp; HỌC PHÍ"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="⚙ Cài đặt Đơn giá" onAction="#handleConfigPrice"
                style="-fx-background-radius: 15; -fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.65" style="-fx-background-color: transparent;">

        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tra cứu Công nợ:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtMaSV" promptText="Nhập Mã Sinh Viên..." prefWidth="250" style="-fx-background-radius: 15;"/>
                <Button text="Tra cứu" onAction="#handleSearchStudent" style="-fx-background-radius: 15; -fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>

            <Separator />

            <Label text="Chi tiết các khoản phí (Học kỳ hiện tại)" style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;"/>
            <TableView fx:id="tableHocPhi" VBox.vgrow="ALWAYS" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colMaMH" text="Mã Môn" prefWidth="90"/>
                    <TableColumn fx:id="colTenMH" text="Tên Môn Học" prefWidth="180"/>
                    <TableColumn fx:id="colSoTC" text="Số TC" prefWidth="70"/>
                    <TableColumn fx:id="colDonGia" text="Đơn giá" prefWidth="110"/>
                    <TableColumn fx:id="colThanhTien" text="Thành tiền" prefWidth="110"/>
                    <TableColumn fx:id="colTrangThaiHocPhan" text="Trạng thái" prefWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="Nhập Mã SV để tra cứu học phí"/>
                </placeholder>
            </TableView>

            <Separator />

            <Label text="Lịch sử các đợt nộp tiền" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="tableLichSuThu" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colNgayThu" text="Ngày Thu" prefWidth="180"/>
                    <TableColumn fx:id="colSoTienNop" text="Số Tiền" prefWidth="180"/>
                    <TableColumn fx:id="colNguoiThu" text="Người Thu" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="Chưa có lịch sử nộp tiền"/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <Label text="THÔNG TIN THANH TOÁN" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>

            <GridPane vgap="10" hgap="10">
                <Label text="Sinh viên:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTenSV" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Lớp:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblLop" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Khoa:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblKhoa" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #2980b9;"/>

                <Label text="CTĐT:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblCTDT" text="..." GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-text-fill: #2980b9;"/>

                <Label text="Cố vấn HT:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblCoVan" text="..." GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-text-fill: #2980b9;"/>

                <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTrangThai" text="..." GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <Separator />

            <VBox spacing="5" alignment="CENTER_RIGHT">
                <Label text="Tổng học phí phát sinh:" style="-fx-text-fill: #7f8c8d;"/>
                <Label fx:id="lblTongTien" text="0 VNĐ" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <Label text="Đã nộp:" style="-fx-text-fill: #2ecc71; -fx-padding: 10 0 0 0;"/>
                <Label fx:id="lblDaNop" text="0 VNĐ" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>

                <Label fx:id="lblTieuDeNo" text="CÒN NỢ:" style="-fx-text-fill: #e74c3c; -fx-padding: 10 0 0 0; -fx-font-weight: bold;"/>
                <Label fx:id="lblConNo" text="0 VNĐ" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="10">
                <Label text="Số tiền thu đợt này (VNĐ):" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtTienThu" promptText="Nhập số tiền sinh viên đóng..." style="-fx-font-size: 14px; -fx-padding: 8;"/>
                <Button text="XÁC NHẬN THU TIỀN" onAction="#handleCollectMoney"
                        maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </SplitPane>
</VBox>