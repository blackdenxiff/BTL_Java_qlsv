<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" styleClass="main-background" stylesheets="@SinhVienStyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.sinhvien.SinhVienController">

    <left>
        <VBox prefWidth="260" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="10">
                    <padding><Insets top="30" bottom="20"/></padding>
                    <Text text="TRƯỜNG ĐẠI HỌC&#10;GIAO THÔNG VẬN TẢI" styleClass="logo-text" textAlignment="CENTER"/>
                </VBox>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Button text="Trang chủ" styleClass="menu-btn" onAction="#showDashboardView"/>
                    <Button text="Thanh toán học phí,&#10;lệ phí" styleClass="menu-btn" onAction="#handleShowTaiChinh"/>
                    <Button text="Tin tức" styleClass="menu-btn" onAction="#handleShowTinTuc"/>
                    <Button text="Góc học tập" styleClass="menu-btn" onAction="#handleShowDiem"/>
                    <Button text="Đăng ký trực tuyến" styleClass="menu-btn" onAction="#handleShowLopMo"/>
                    <Button text="Tra cứu lịch" styleClass="menu-btn" onAction="#handleShowTKB"/>
                </VBox>

                <VBox alignment="CENTER">
                    <HBox alignment="CENTER" spacing="15">
                        <padding><Insets bottom="20"/></padding>
                        <Button text="Đổi mật khẩu" style="-fx-background-color: transparent; -fx-text-fill: #fdb913; -fx-cursor: hand;" onAction="#handleChangePassword"/>
                        <Button text="Đăng xuất" styleClass="logout-btn" style="-fx-padding: 5 0 5 0;" onAction="#handleLogout"/>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-wrapper">
            <HBox styleClass="header" alignment="CENTER_RIGHT" spacing="20" prefHeight="60">
                <padding><Insets left="20" right="30"/></padding>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10" onMouseClicked="#handleShowProfile" style="-fx-cursor: hand;">
                    <Circle radius="15" styleClass="avatar-circle"/>
                    <Label fx:id="lblHoTen" text="TÊN ĐĂNG NHẬP" styleClass="user-name"/>
                </HBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS" styleClass="content-bg">

                <VBox fx:id="viewDashboard" spacing="20">
                    <Label text="Xin chào!" styleClass="greeting-text"/>
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <VBox styleClass="section-card" HBox.hgrow="ALWAYS" prefWidth="400">
                            <Label text="Tiến độ học tập" styleClass="section-title"/>
                            <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
                                <Label fx:id="lblTienDo" text="0 / 120 Tín chỉ" style="-fx-font-size: 24px; -fx-text-fill: #293e73;"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="600">
                            <VBox styleClass="section-card" spacing="15">
                                <BorderPane>
                                    <left><Label text="Tin tức" styleClass="section-title" BorderPane.alignment="CENTER"/></left>
                                    <right><Label text="Xem tất cả" styleClass="see-all" BorderPane.alignment="CENTER"/></right>
                                </BorderPane>
                                <HBox spacing="15">
                                    <VBox styleClass="sticky-note" alignment="CENTER"><Label text="THÔNG BÁO" styleClass="sticky-title"/><Label text="TB tổ chức rút bớt&#10;học phần HK II 25-26" wrapText="true" textAlignment="CENTER"/></VBox>
                                    <VBox styleClass="sticky-note" alignment="CENTER"><Label text="THÔNG BÁO" styleClass="sticky-title"/><Label text="TB thi ngoại ngữ tự do&#10;dành cho SV chính quy" wrapText="true" textAlignment="CENTER"/></VBox>
                                    <VBox styleClass="sticky-note" alignment="CENTER"><Label text="THÔNG BÁO" styleClass="sticky-title"/><Label text="Lịch lên lớp Thực tập&#10;xưởng (N08)..." wrapText="true" textAlignment="CENTER"/></VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="viewTKB" spacing="15" visible="false" styleClass="section-card">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="THỜI KHÓA BIỂU CHI TIẾT" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10" alignment="CENTER">
                            <Button text="&lt;" onAction="#handlePrevWeek" style="-fx-cursor: hand; -fx-background-radius: 15; -fx-background-color: #293e73; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Label fx:id="lblWeekRange" text="dd/MM - dd/MM" style="-fx-font-weight: bold; -fx-text-fill: #293e73; -fx-font-size: 14px;"/>
                            <Button text="&gt;" onAction="#handleNextWeek" style="-fx-cursor: hand; -fx-background-radius: 15; -fx-background-color: #293e73; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                    </HBox>

                    <GridPane fx:id="gridTKB" hgap="2" vgap="2" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #ecf0f1; -fx-padding: 2; -fx-border-color: #dcdde1; -fx-border-width: 1;">
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Xuất TKB (PDF)" onAction="#handleXuatTKB" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
                <VBox fx:id="viewDiem" spacing="10" visible="false" styleClass="section-card">
                    <Label text="KẾT QUẢ HỌC TẬP" styleClass="section-title"/>
                    <TableView fx:id="tblDiem" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDiemTenMH" text="Môn học" prefWidth="300"/>
                            <TableColumn fx:id="colSoTC" text="Số TC" prefWidth="80"/>
                            <TableColumn fx:id="colDiemSo" text="Điểm hệ 10" prefWidth="100"/>
                            <TableColumn fx:id="colDiemChu" text="Điểm chữ" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox fx:id="viewLopMo" spacing="10" visible="false" styleClass="section-card">
                    <Label text="ĐĂNG KÝ TRỰC TUYẾN" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtMaLHPReg" promptText="Tìm môn hoặc nhập mã..." prefWidth="250" style="-fx-padding: 8;"/>
                        <Button text="Đăng ký" onAction="#handleActionDangKy" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand;"/>
                        <Button text="Rút môn" onAction="#handleActionRutMon" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView fx:id="tblLopMo" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMoMaLHP" text="Mã lớp" prefWidth="120"/>
                            <TableColumn fx:id="colMoTenMH" text="Môn học" prefWidth="300"/>
                            <TableColumn fx:id="colMoCa" text="Ca học" prefWidth="100"/>
                            <TableColumn fx:id="colMoPhong" text="Phòng" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox fx:id="viewTaiChinh" spacing="15" visible="false" styleClass="section-card">
                    <Label text="THÔNG TIN HỌC PHÍ &amp; THANH TOÁN TRỰC TUYẾN" styleClass="section-title"/>

                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <TableView fx:id="tblTaiChinh" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colTCMaMH" text="Mã MH" prefWidth="100"/>
                                    <TableColumn fx:id="colTCTenMH" text="Tên môn học" prefWidth="250"/>
                                    <TableColumn fx:id="colTCSoTC" text="Số TC" prefWidth="70"/>
                                    <TableColumn fx:id="colTCDonGia" text="Đơn giá" prefWidth="120"/>
                                    <TableColumn fx:id="colTCThanhTien" text="Thành tiền" prefWidth="130"/>
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10; -fx-background-color: #f8f9fa;">
                                <Label text="TỔNG TIỀN CẦN ĐÓNG:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                                <Label fx:id="lblCongNoSV" text="0 VNĐ" style="-fx-font-size: 20px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="15" alignment="TOP_CENTER" prefWidth="320"
                              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-width: 2;">

                            <Label text="QUÉT MÃ THANH TOÁN" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #293e73;"/>

                            <StackPane prefWidth="220" prefHeight="220" style="-fx-background-color: #f9f9f9; -fx-border-color: #eee;">
                                <ImageView fx:id="imgQRHocPhi" fitWidth="200" fitHeight="200" preserveRatio="true"/>
                                <ProgressIndicator fx:id="pgLoadingQR" visible="false" maxHeight="50" maxWidth="50"/>
                            </StackPane>

                            <VBox alignment="CENTER" spacing="5">
                                <Label fx:id="lblStatusQR" text="Nhấn nút bên dưới để lấy mã" wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="lblNoiDungQR" text="" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="5">
                                <Label text="Nhập số tiền muốn nộp (VNĐ):" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                                <TextField fx:id="txtSoTienNop" alignment="CENTER" promptText="Nhập số tiền..."
                                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-background-radius: 5;"/>
                            </VBox>

                            <Button fx:id="btnTaoQR" text="TẠO MÃ QR" onAction="#handleTaoQRTaiCho"
                                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-cursor: hand; -fx-background-radius: 20;"/>

                            <Separator />
                            <Label text="Hệ thống tự động cập nhật sau 3-5s" style="-fx-font-size: 10px; -fx-text-fill: #95a5a6;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>