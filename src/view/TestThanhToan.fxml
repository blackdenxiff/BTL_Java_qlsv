<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.TestThanhToanController"
      alignment="CENTER" spacing="20"
      style="-fx-padding: 40; -fx-background-color: #f4f6f9;">

    <Label text="THANH TOÁN HỌC PHÍ QUA QR"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e3c72;"/>

    <VBox alignment="CENTER" spacing="15"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Vui lòng quét mã bên dưới để thanh toán" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>

        <StackPane style="-fx-border-color: #ecf0f1; -fx-border-width: 2; -fx-border-radius: 10;">
            <ImageView fx:id="imgQR" fitWidth="280" fitHeight="280" preserveRatio="true"/>
        </StackPane>

        <Label fx:id="lblNoiDung" text="Nội dung: HD123"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
    </VBox>

    <HBox alignment="CENTER" spacing="15">
        <Label text="Số tiền cần trả:" style="-fx-font-size: 18;"/>
        <Label fx:id="lblSoTien" text="10,000 VNĐ"
               style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
    </HBox>


</VBox>