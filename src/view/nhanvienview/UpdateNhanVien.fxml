<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.nhanvien.UpdateNhanVien"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: #f4f6f9;">

    <!-- TITLE -->
    <Label text="QUẢN LÝ NHÂN VIÊN"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- FORM -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,3);">

        <GridPane hgap="15" vgap="10">

            <Label text="Mã NV:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMaNV" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Họ đệm:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtHoDem" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Tên:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTen" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Ngày sinh:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dpNgaySinh" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Giới tính:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtGioiTinh" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Loại NV:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <TextField fx:id="txtLoaiNV" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Mã khoa:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMaKhoa" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Học vấn:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <TextField fx:id="txtHocVan" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <Label text="SĐT:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtSDT" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

        </GridPane>

        <!-- BUTTON -->
        <HBox spacing="10">
            <Button text="🔍 Tìm kiếm" onAction="#handleTimKiem"/>
            <Button text="➕ Thêm" onAction="#handleThem"/>
            <Button text="✏️ Sửa" onAction="#handleSua"/>
        </HBox>

    </VBox>

    <!-- TABLE -->
    <VBox spacing="10"
          style="-fx-background-color:white;
                 -fx-padding:15;
                 -fx-background-radius:12;
                 -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.1),10,0,0,3);">

        <Label text="Danh sách nhân viên"
               style="-fx-font-size:16; -fx-font-weight:bold;"/>

        <TableView fx:id="tableNhanVien"
                   onMouseClicked="#handleClickTable"
                   prefHeight="700">

            <columns>
                <TableColumn fx:id="colMaNV" text="Mã NV"/>
                <TableColumn fx:id="colHoTen" text="Họ tên"/>
                <TableColumn fx:id="colNgaySinh" text="Ngày sinh"/>
                <TableColumn fx:id="colGioiTinh" text="Giới tính"/>
                <TableColumn fx:id="colLoaiNV" text="Loại NV"/>
                <TableColumn fx:id="colKhoa" text="Khoa"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </VBox>

</VBox>