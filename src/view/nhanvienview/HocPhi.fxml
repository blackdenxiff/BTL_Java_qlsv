<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.nhanvien.HocPhiController"
      spacing="30"
      alignment="TOP_CENTER"
      style="-fx-padding: 40; -fx-background-color: transparent;">

    <Label text="💰 TÍNH HỌC PHÍ SINH VIÊN"
           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e3c72;"/>

    <VBox spacing="25"
          maxWidth="550"
          style="-fx-background-color: white;
                 -fx-padding: 40;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15,0,0,5);">

        <VBox spacing="10">
            <Label text="Mã sinh viên:" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <TextField fx:id="txtMaSV" promptText="Nhập mã sinh viên cần tra cứu..."
                       prefHeight="45"
                       style="-fx-font-size: 15; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-radius: 6;"/>
        </VBox>

        <VBox spacing="10">
            <Label text="Đơn giá / 1 tín chỉ (VNĐ):" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <TextField fx:id="txtDonGia" promptText="Ví dụ: 500000"
                       prefHeight="45"
                       style="-fx-font-size: 15; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-radius: 6;"/>
        </VBox>

        <HBox alignment="CENTER" style="-fx-padding: 15 0 0 0;">
            <Button text="💳 Tính Học Phí" onAction="#handleTinhHocPhi"
                    prefHeight="50" prefWidth="250"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 10,0,0,4);"/>
        </HBox>

    </VBox>

</VBox>