<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.nhanvien.NhapDiemController"

      spacing="20"
      style="-fx-padding: 20; -fx-background-color: #f4f6f9;">

    <!-- TITLE -->
    <Label text="NHẬP ĐIỂM SINH VIÊN"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- FORM NHẬP LỚP -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,3);">

        <GridPane hgap="15" vgap="10">

            <Label text="Mã lớp học phần:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMaLHP" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>
            <Button text="Tải danh sách" onAction="#handleLoad" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        </GridPane>

    </VBox>

    <!-- TABLE -->
    <VBox spacing="10"
          style="-fx-background-color:white;
                 -fx-padding:15;
                 -fx-background-radius:12;
                 -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.1),10,0,0,3);">

        <Label text="Danh sách sinh viên" style="-fx-font-size:16; -fx-font-weight:bold;"/>

        <TableView fx:id="tableDiem" prefHeight="400">

            <columns>
                <TableColumn fx:id="colMaSV" text="Mã SV" prefWidth="120"/>
                <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="200"/>
                <TableColumn fx:id="colDiem" text="Điểm" prefWidth="100"/>
                <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="150"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </VBox>

    <!-- FORM NHẬP ĐIỂM -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,3);">

        <GridPane hgap="15" vgap="10">

            <Label text="Mã SV:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMaSV" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Điểm:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtDiem" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        </GridPane>

        <!-- BUTTON -->
        <HBox spacing="10">
            <Button text="💾 Lưu điểm" onAction="#handleSave"/>
            <Button text="📤 Xuất Excel" onAction="#handleExport"/>
        </HBox>

    </VBox>

</VBox>