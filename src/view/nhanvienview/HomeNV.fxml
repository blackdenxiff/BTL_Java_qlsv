<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.nhanvien.HomeNVController"
            stylesheets="@style.css">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: #1e3c72; -fx-padding: 12 25;">

            <ImageView fitHeight="45" preserveRatio="true">
                <image>
                    <Image url="@/view/imge/logo_login.png"/>
                </image>
            </ImageView>

            <Label text="HỆ THỐNG QUẢN Dành Cho Nhân Viên"
                   style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="👤 Nhân viên"
                   style="-fx-text-fill: white;"/>

            <Button text="Đăng xuất"
                    onAction="#handleLogout"
                    styleClass="logout-button"
                    style="-fx-min-width: 90;"/>
        </HBox>
    </top>

    <left>
        <BorderPane prefWidth="250"
                    style="-fx-background-color: linear-gradient(to bottom,#1e3c72,#2a5298); -fx-padding: 15;">

            <top>
                <VBox spacing="12">
                    <Label text="HỆ THỐNG Nhân Viên"
                           style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

                    <Accordion fx:id="menuAccordion">
                        <panes>
                            <TitledPane text="Trang chủ" expanded="false">
                                <content>
                                    <VBox spacing="5" style="-fx-padding: 5;">
                                        <Button text="Dashboard" onAction="#handleHome"
                                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3c72; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                    </VBox>
                                </content>
                            </TitledPane>

                            <TitledPane text="Quản lý" expanded="false">
                                <content>
                                    <VBox spacing="5" style="-fx-padding: 5;">
                                        <Button text="Sinh viên" onAction="#handleSinhVien"
                                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3c72; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                    </VBox>
                                </content>
                            </TitledPane>

                            <TitledPane text="Giảng dạy" expanded="false">
                                <content>
                                    <VBox spacing="5" style="-fx-padding: 5;">
                                        <Button text="Lớp học phần" onAction="#handleLopHocPhan"
                                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3c72; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                    </VBox>
                                </content>
                            </TitledPane>

                            <TitledPane text="Điểm" expanded="false">
                                <content>
                                    <VBox spacing="5" style="-fx-padding: 5;">
                                        <Button text="Nhập điểm" onAction="#handleNhapDiem"
                                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3c72; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                    </VBox>
                                </content>
                            </TitledPane>

                            <TitledPane text="Tài chính" expanded="false">
                                <content>
                                    <VBox spacing="5" style="-fx-padding: 5;">
                                        <Button text="Học phí" onAction="#handleHocPhi"
                                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3c72; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                    </VBox>
                                </content>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </top>

            <bottom>
                <HBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20" left="20"/>
                    </padding>
                    <Button text="Đổi mật khẩu"
                            style="-fx-background-color: linear-gradient(to bottom, #ffffff, #e0e0e0);
                                   -fx-border-color: #a6a6a6;
                                   -fx-border-radius: 4;
                                   -fx-background-radius: 4;
                                   -fx-text-fill: #1e3c72;
                                   -fx-cursor: hand;
                                   -fx-padding: 6 15;"
                            onAction="#handleChangePassword"/>
                </HBox>
            </bottom>
        </BorderPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: #f4f6f9; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="contentArea"
                      alignment="TOP_CENTER"
                      spacing="20"
                      style="-fx-padding: 30; -fx-background-color: #f4f6f9;"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>